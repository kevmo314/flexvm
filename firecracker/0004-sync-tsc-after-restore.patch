+    /// `KVM_{HAS,GET,SET}_DEVICE_ATTR` on this vCPU (kvm-ioctls has them for aarch64 only).
+    fn device_attr(&self, nr: u64, attr: &kvm_bindings::kvm_device_attr) -> Result<(), kvm_ioctls::Error> {
+        // _IOW(KVMIO, nr, struct kvm_device_attr)
+        let req = (1u64 << 30) | ((std::mem::size_of::<kvm_bindings::kvm_device_attr>() as u64) << 16) | (0xae << 8) | nr;
+        // SAFETY: a vCPU fd and a kvm_device_attr whose addr points at a live u64.
+        match unsafe { libc::ioctl(self.fd.as_raw_fd(), req as _, attr as *const _) } {
+            0 => Ok(()),
+            _ => Err(kvm_ioctls::Error::last()),
+        }
+    }
+
+    /// Sets the given MSRs, of those `state` saved, again (TSC before TSC deadline).
+    fn restore_msrs(&self, state: &VcpuState, which: &[u32]) -> Result<(), KvmVcpuError> {
+        let mut entries: Vec<_> = state
+            .saved_msrs
+            .iter()
+            .flat_map(|msrs| msrs.as_slice().iter().copied())
+            .filter(|msr| which.contains(&msr.index))
+            .collect();
+        entries.sort_by_key(|msr| msr.index != MSR_IA32_TSC);
+        if entries.is_empty() {
+            return Ok(());
+        }
+        let msrs = Msrs::from_entries(&entries).map_err(|_| KvmVcpuError::VcpuSetMsrsIncomplete)?;
+        let nmsrs = self.fd.set_msrs(&msrs).map_err(KvmVcpuError::VcpuSetMsrs)?;
+        if nmsrs < entries.len() {
+            return Err(KvmVcpuError::VcpuSetMsrsIncomplete);
+        }
+        Ok(())
+    }
+}
