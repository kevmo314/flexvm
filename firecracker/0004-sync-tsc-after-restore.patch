+/// Once every vCPU is restored: gives them all one TSC offset, vCPU 0's, as they had on the
+/// source (`KVM_VCPU_TSC_OFFSET`, Linux 5.16+), then sets each one's TSC deadline, which counts
+/// in its TSC, again. Each vCPU's restore wrote its TSC, and KVM takes such writes as in sync
+/// only if they come within a second of each other, which restoring one vCPU can outlast (its
+/// MSRs map guest pages, which may still have to be paged in): the TSCs, the guest's
+/// clocksource, then ended up apart by as long. Every vCPU gets the offset, vCPU 0 too, so all
+/// are in the same KVM TSC generation (its master clock and the pvclock stable flag need it).
+/// Without the attribute a restore of more than one vCPU fails rather than risk a guest whose
+/// clock jumps.
+pub fn sync_tscs(vcpus: &[&KvmVcpu], states: &[VcpuState]) -> Result<(), KvmVcpuError> {
+    const KVM_SET_DEVICE_ATTR: u64 = 0xe1;
+    const KVM_GET_DEVICE_ATTR: u64 = 0xe2;
+    const KVM_HAS_DEVICE_ATTR: u64 = 0xe3;
+    let Some(first) = vcpus.first() else { return Ok(()) };
+    let mut offset = 0u64;
+    let attr = kvm_bindings::kvm_device_attr {
+        flags: 0,
+        group: kvm_bindings::KVM_VCPU_TSC_CTRL,
+        attr: u64::from(kvm_bindings::KVM_VCPU_TSC_OFFSET),
+        addr: std::ptr::addr_of_mut!(offset) as u64,
+    };
+    if first.device_attr(KVM_HAS_DEVICE_ATTR, &attr).is_err() {
+        return match vcpus.len() {
+            1 => Ok(()),
+            _ => Err(KvmVcpuError::VcpuTscOffsetUnsupported),
+        };
+    }
+    first.device_attr(KVM_GET_DEVICE_ATTR, &attr).map_err(KvmVcpuError::VcpuTscOffset)?;
+    for (vcpu, state) in vcpus.iter().zip(states) {
+        vcpu.device_attr(KVM_SET_DEVICE_ATTR, &attr).map_err(KvmVcpuError::VcpuTscOffset)?;
+        vcpu.restore_msrs(state, &[MSR_IA32_TSC_DEADLINE])?;
+    }
+    Ok(())
 }
 
