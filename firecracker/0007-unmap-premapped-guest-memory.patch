     use super::*;
     use crate::Vmm;
+
+    // flexvm: pages another process faulted in before the registration are gone after it, and the range is
+    // registered still.
+    #[test]
+    fn test_unmap_premapped() {
+        use std::os::unix::fs::FileExt;
+
+        let page = host_page_size();
+        let len = 64 * page;
+        // SAFETY: a fresh anonymous mapping, unmapped at the end.
+        let addr = unsafe {
+            libc::mmap(
+                std::ptr::null_mut(),
+                len,
+                libc::PROT_READ | libc::PROT_WRITE,
+                libc::MAP_PRIVATE | libc::MAP_ANONYMOUS,
+                -1,
+                0,
+            )
+        }
+        .cast::<u8>();
+        assert_ne!(addr, libc::MAP_FAILED.cast());
+        let resident = || {
+            let mut v = vec![0u8; 64];
+            // SAFETY: `v` has a byte for each page of the mapping.
+            assert_eq!(unsafe { libc::mincore(addr.cast(), len, v.as_mut_ptr()) }, 0);
+            v.iter().filter(|&&r| r & 1 != 0).count()
+        };
+        // As a scanner reads it: through /proc/self/mem, which maps the zero page.
+        let mem = File::open("/proc/self/mem").unwrap();
+        let mut b = [0u8; 1];
+        for i in [0, 5, 63] {
+            mem.read_exact_at(&mut b, (addr as usize + i * page) as u64).unwrap();
+        }
+        assert_eq!(resident(), 3);
+        // Unprivileged processes may only handle faults from user space.
+        let uffd = UffdBuilder::new()
+            .close_on_exec(true)
+            .non_blocking(true)
+            .user_mode_only(true)
+            .create()
+            .unwrap();
+        uffd.register(addr.cast(), len).unwrap();
+        unmap_premapped(&uffd, addr, len).unwrap();
+        assert_eq!(resident(), 0);
+        // Registered: a read through /proc/self/mem now fails rather than mapping a page behind the handler.
+        assert!(mem.read_exact_at(&mut b, addr as u64).is_err());
+        assert_eq!(resident(), 0);
+        // SAFETY: mapped above.
+        unsafe { libc::munmap(addr.cast(), len) };
+    }
