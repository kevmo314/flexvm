+
+/// flexvm: how many times `unmap_premapped` drops pages mapped behind the userfaultfd's back.
+const PREMAPPED_TRIES: usize = 16;
+
+/// flexvm: drops whatever of the registered `[addr, addr + len)` is mapped already. Another process that reads ours
+/// (`/proc/PID/mem`, `process_vm_readv`: a debugger, a memory scanner) between the mmap and the registration faults
+/// pages in the ordinary way, the zero page or, with THP, the huge zero page for 2 MiB. Registering leaves them mapped:
+/// the guest never faults on them, the handler never fills them, and the guest reads zeroes where the snapshot has
+/// data. They are dropped with the range unregistered, so that the handler gets no REMOVE event for them, and the
+/// range is checked again once it is registered again, until nothing of it is mapped.
+fn unmap_premapped(uffd: &Uffd, addr: *mut u8, len: usize) -> Result<(), GuestMemoryFromUffdError> {
+    let page = host_page_size();
+    let mut resident = vec![0u8; len.div_ceil(page)];
+    // Checked once more after the last drop, then given up.
+    for tries in 0..=PREMAPPED_TRIES {
+        // SAFETY: the range is one mapping of ours and `resident` has a byte for each of its pages.
+        if unsafe { libc::mincore(addr.cast(), len, resident.as_mut_ptr()) } != 0 {
+            return Err(GuestMemoryFromUffdError::Premapped(io::Error::last_os_error()));
+        }
+        let Some(first) = resident.iter().position(|&r| r & 1 != 0) else {
+            return Ok(());
+        };
+        if tries == PREMAPPED_TRIES {
+            break;
+        }
+        let last = resident.iter().rposition(|&r| r & 1 != 0).unwrap();
+        warn!(
+            "guest memory at {:#x}..{:#x} was mapped before its userfaultfd covered it; dropping it",
+            addr as usize + first * page,
+            addr as usize + (last + 1) * page
+        );
+        uffd.unregister(addr.cast(), len)
+            .map_err(GuestMemoryFromUffdError::Register)?;
+        // SAFETY: nothing of the guest's is in this memory yet: it is only being set up.
+        if unsafe { libc::madvise(addr.cast(), len, libc::MADV_DONTNEED) } != 0 {
+            return Err(GuestMemoryFromUffdError::Premapped(io::Error::last_os_error()));
+        }
+        uffd.register(addr.cast(), len)
+            .map_err(GuestMemoryFromUffdError::Register)?;
+    }
+    Err(GuestMemoryFromUffdError::Premapped(io::Error::other(format!(
+        "still mapped after dropping it {PREMAPPED_TRIES} times"
+    ))))
 }
 
