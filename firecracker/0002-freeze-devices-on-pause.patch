diff --git a/src/vmm/src/devices/virtio/freeze.rs b/src/vmm/src/devices/virtio/freeze.rs
new file mode 100644
index 0000000..db44b45
--- /dev/null
+++ b/src/vmm/src/devices/virtio/freeze.rs
@@ -0,0 +1,62 @@
+// Copyright 2026 flexvm authors.
+// SPDX-License-Identifier: Apache-2.0
+
+//! Freezes virtio device processing while the VM is paused.
+//!
+//! Pausing only stops the vCPUs; the VMM thread would otherwise go on
+//! handling queue notifications, timers and backend I/O, writing guest memory
+//! and used rings behind a snapshot that has already been taken. While frozen,
+//! device event handlers leave guest memory alone: a level-triggered eventfd
+//! is drained and signalled again on thaw, so no notification is lost, and
+//! host-side work that cannot wait (rate limiter timers, vsock backend events)
+//! is done without touching the queues. Resuming also kicks every device.
+
+use std::os::fd::{AsRawFd, RawFd};
+use std::sync::Mutex;
+use std::sync::atomic::{AtomicBool, Ordering};
+
+use event_manager::Events;
+
+static FROZEN: AtomicBool = AtomicBool::new(false);
+/// Eventfds to signal again on thaw.
+static DEFERRED: Mutex<Vec<RawFd>> = Mutex::new(Vec::new());
+
+/// Whether device processing is frozen (the VM is paused).
+pub fn frozen() -> bool {
+    FROZEN.load(Ordering::SeqCst)
+}
+
+/// Freezes device processing; called once the vCPUs are paused.
+pub fn freeze() {
+    FROZEN.store(true, Ordering::SeqCst);
+}
+
+/// Unfreezes device processing and replays the notifications that arrived
+/// while frozen; called before the vCPUs resume.
+pub fn thaw() {
+    FROZEN.store(false, Ordering::SeqCst);
+    let mut fds = std::mem::take(&mut *DEFERRED.lock().unwrap());
+    fds.sort_unstable();
+    fds.dedup();
+    for fd in fds {
+        let one = 1u64;
+        // SAFETY: writes 8 bytes from a valid u64 to an eventfd we own. A
+        // timerfd (which cannot be written) just skips its tick.
+        unsafe { libc::write(fd, (&one as *const u64).cast(), 8) };
+    }
+}
+
+/// Signals eventfd `fd` again on thaw.
+pub fn renotify(fd: &impl AsRawFd) {
+    DEFERRED.lock().unwrap().push(fd.as_raw_fd());
+}
+
+/// Takes a level-triggered eventfd or timerfd event out of the way while
+/// frozen: reads it (or it would fire again at once) and signals it again on
+/// thaw.
+pub fn defer(event: &Events) {
+    let mut count = 0u64;
+    // SAFETY: reads 8 bytes into a valid u64 from a nonblocking eventfd/timerfd.
+    unsafe { libc::read(event.fd(), (&mut count as *mut u64).cast(), 8) };
+    DEFERRED.lock().unwrap().push(event.fd());
+}
