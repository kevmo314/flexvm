+    #[test]
+    fn test_dump_resident() {
+        let page_size = host_page_size();
+        let pages = 3 * PageMap::CHUNK / 2 + 3;
+        // Two regions with a gap between them; the first spans more than one pagemap read.
+        let region_1 = GuestAddress(0);
+        let region_2 = GuestAddress(((pages + 2) * page_size) as u64);
+        let mem_regions = [(region_1, pages * page_size), (region_2, 4 * page_size)];
+        let guest_memory = into_region_ext(
+            anonymous(mem_regions.into_iter(), false, HugePageConfig::None).unwrap(),
+        );
+        assert!(guest_memory.anonymous_private());
+        let page = |n: usize| GuestAddress((n * page_size) as u64);
+        for n in [0, 1, 7, PageMap::CHUNK - 1, PageMap::CHUNK, pages - 1] {
+            let fill = u8::try_from(n % 251).unwrap() + 1;
+            guest_memory.write(&vec![fill; page_size], page(n)).unwrap();
+        }
+        // Read but never written: the shared zero page, written out as zeroes.
+        let mut buf = vec![0u8; page_size];
+        guest_memory.read(&mut buf, page(9)).unwrap();
+        // Written, then discarded as free page reporting does.
+        guest_memory.write(&vec![5u8; page_size], page(11)).unwrap();
+        guest_memory.discard_range(page(11), page_size).unwrap();
+        guest_memory
+            .write(&vec![6u8; 4 * page_size], region_2)
+            .unwrap();
+        guest_memory
+            .discard_range(region_2.unchecked_add(page_size as u64), page_size)
+            .unwrap();
+
+        let size = ((pages + 4) * page_size) as u64;
+        // Sparse first: reading a page with no data maps the zero page, which then is present.
+        let mut sparse = TempFile::new().unwrap().into_file();
+        sparse.set_len(size).unwrap();
+        let mut pagemap = PageMap::open().unwrap();
+        guest_memory
+            .dump_resident(&mut sparse, &mut pagemap)
+            .unwrap();
+        assert_eq!(sparse.stream_position().unwrap(), size);
+        let mut full = TempFile::new().unwrap().into_file();
+        full.set_len(size).unwrap();
+        guest_memory.dump(&mut full).unwrap();
+
+        let (mut a, mut b) = (Vec::new(), Vec::new());
+        full.rewind().unwrap();
+        full.read_to_end(&mut a).unwrap();
+        sparse.rewind().unwrap();
+        sparse.read_to_end(&mut b).unwrap();
+        assert_eq!(a.len(), b.len());
+        assert!(a == b, "dump_resident differs from dump");
+
+        // Untouched and discarded pages are holes; written and read ones are data.
+        let data_at = |off: usize| {
+            let off = i64::try_from(off).unwrap();
+            unsafe { libc::lseek(sparse.as_raw_fd(), off, libc::SEEK_DATA) == off }
+        };
+        for n in [
+            0,
+            1,
+            7,
+            9,
+            PageMap::CHUNK - 1,
+            PageMap::CHUNK,
+            pages - 1,
+            pages,
+        ] {
+            assert!(data_at(n * page_size), "page {n} should be data");
+        }
+        for n in [2, 8, 10, 11, 12, PageMap::CHUNK + 1, pages + 1] {
+            assert!(!data_at(n * page_size), "page {n} should be a hole");
+        }
+    }
