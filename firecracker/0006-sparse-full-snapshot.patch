+/// This process's page table entries, from `/proc/self/pagemap`: which pages of a mapping hold
+/// data, in RAM or swapped out. Unlike `mincore(2)`, it tells a swapped-out page from one that was
+/// never touched or was discarded (`MADV_DONTNEED`/`MADV_REMOVE`).
+#[derive(Debug)]
+pub struct PageMap {
+    file: File,
+    /// One read's entries, 8 bytes per page: reused by every read.
+    entries: Vec<u8>,
+}
+
+impl PageMap {
+    /// Pages per read: 32 MiB of guest memory with 4 KiB pages.
+    const CHUNK: usize = 8192;
+    /// The page is in RAM.
+    const PRESENT: u64 = 1 << 63;
+    /// The page is swapped out (or being migrated).
+    const SWAPPED: u64 = 1 << 62;
+
+    /// Opens this process's pagemap. Fails where `/proc` is not mounted (e.g. in a jail).
+    pub fn open() -> io::Result<Self> {
+        Ok(Self {
+            file: File::open("/proc/self/pagemap")?,
+            entries: vec![0; Self::CHUNK * 8],
+        })
+    }
+
+    /// Whether each of the `count` (at most [`Self::CHUNK`]) host pages from `addr` holds data.
+    fn backed(&mut self, addr: usize, count: usize) -> io::Result<impl Iterator<Item = bool> + '_> {
+        use std::io::{Read, Seek};
+        let entries = &mut self.entries[..count * 8];
+        // pread64 is not in the VMM thread's seccomp filter; lseek and read are.
+        self.file
+            .seek(SeekFrom::Start((addr / host_page_size() * 8) as u64))?;
+        self.file.read_exact(entries)?;
+        Ok(entries.chunks_exact(8).map(|e| {
+            u64::from_ne_bytes(e.try_into().unwrap()) & (Self::PRESENT | Self::SWAPPED) != 0
+        }))
+    }
+}
