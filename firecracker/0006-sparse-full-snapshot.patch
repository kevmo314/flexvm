+    /// Dumps the slot onto the writer, seeking over the pages `pagemap` reports hold no data
+    /// (never touched, or discarded): in anonymous private memory with no userfaultfd those read
+    /// as zero, so the writer must read as zero wherever this does not write.
+    pub(crate) fn dump_resident<T: WriteVolatile + std::io::Seek>(
+        &self,
+        writer: &mut T,
+        pagemap: &mut PageMap,
+    ) -> Result<(), MemoryError> {
+        let page_size = host_page_size();
+        let len = self.slice.len();
+        let addr = self.slice.ptr_guard().as_ptr() as usize;
+        // Writes [start, end) if it holds data, or seeks over it.
+        let mut flush = |start: usize, end: usize, backed: bool| -> Result<(), MemoryError> {
+            if end == start {
+                Ok(())
+            } else if backed {
+                Ok(writer.write_all_volatile(&self.slice.subslice(start, end - start)?)?)
+            } else {
+                let offset =
+                    i64::try_from(end - start).map_err(|_| MemoryError::SlotSizeTooLarge)?;
+                writer
+                    .seek(SeekFrom::Current(offset))
+                    .map(drop)
+                    .map_err(MemoryError::SeekError)
+            }
+        };
+        // The current run of pages that all hold data (or all do not), from `start`.
+        let (mut start, mut backed) = (0, true);
+        let mut off = 0;
+        while off < len {
+            let count = (len - off).div_ceil(page_size).min(PageMap::CHUNK);
+            let pages = pagemap
+                .backed(addr + off, count)
+                .map_err(MemoryError::PageMap)?;
+            for (i, page) in pages.enumerate() {
+                if page != backed {
+                    let at = off + i * page_size;
+                    flush(start, at, backed)?;
+                    (start, backed) = (at, page);
+                }
+            }
+            off += count * page_size;
+        }
+        flush(start, len, backed)
+    }
