+/// flexvm: see `VmmAction::PrepareSnapshot`. Only the UFFD memory backend is supported.
+pub fn prepare_from_snapshot(
+    params: &LoadSnapshotParams,
+) -> Result<PreparedRestore, RestoreFromSnapshotError> {
+    if params.mem_backend.backend_type != MemBackendType::Uffd {
+        return Err(RestoreFromSnapshotError::Prepared(
+            "only the Uffd memory backend can be prepared".into(),
+        ));
+    }
+    let mut state = snapshot_state_from_file(&params.snapshot_path)?;
+    snapshot_state_sanity_check(&state)?;
+    if let (Some(vsock_override), VirtioDevicesState::Mmio(mmio_state)) = (
+        &params.vsock_override,
+        &mut state.device_states.virtio_state,
+    ) && let Some(vsock) = mmio_state.vsock_device.as_mut()
+    {
+        vsock
+            .device_state
+            .backend
+            .uds_path
+            .clone_from(&vsock_override.uds_path);
+    }
+    let huge_pages = params.huge_pages.resolve(state.vm_info.huge_pages);
+    let (guest_memory, uffd) = guest_memory_from_uffd(
+        &params.mem_backend.backend_path,
+        &state.vm_state.memory,
+        params.track_dirty_pages,
+        huge_pages,
+    )
+    .map_err(RestoreFromSnapshotGuestMemoryError::Uffd)?;
+    let (vm, vcpus) = builder::prepare_microvm_from_snapshot(&state, guest_memory)?;
+    Ok(PreparedRestore {
+        state,
+        backend_path: params.mem_backend.backend_path.clone(),
+        track_dirty_pages: params.track_dirty_pages,
+        huge_pages: params.huge_pages,
+        vm,
+        vcpus,
+        uffd,
+    })
+}
