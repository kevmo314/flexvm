+    huge_pages: crate::vmm_config::snapshot::SnapshotLoadHugePageConfig,
+    vm: vstate::vm::KvmVm,
+    vcpus: Vec<vstate::vcpu::Vcpu>,
+    uffd: Option<Uffd>,
