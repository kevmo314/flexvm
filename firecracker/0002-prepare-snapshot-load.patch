+    /// flexvm: the vsock backend prepared for `cid` at `path`, if any.
+    pub fn take_prepared_vsock(
+        &self,
+        cid: u64,
+        path: &str,
+    ) -> Option<crate::devices::virtio::vsock::VsockUnixBackend> {
+        let mut prepared = self.common.prepared_devices.lock().unwrap();
+        match &prepared.vsock {
+            Some((c, p, _)) if *c == cid && p == path => prepared.vsock.take().map(|v| v.2),
+            _ => None,
+        }
+    }
+
+    /// flexvm: the pmem mapping and KVM slot prepared for this file at this guest range, if any.
+    pub fn take_prepared_pmem(
+        &self,
+        path: &str,
+        read_only: bool,
+        start: u64,
+        size: u64,
+    ) -> Option<(crate::devices::virtio::pmem::device::PmemMmap, u32)> {
+        let mut prepared = self.common.prepared_devices.lock().unwrap();
+        let i = prepared
+            .pmem
+            .iter()
+            .position(|p| p.0 == path && p.1 == read_only && p.2 == start && p.3 == size)?;
+        let p = prepared.pmem.swap_remove(i);
+        Some((p.4, p.5))
+    }
