+/// flexvm: refuses a load of `state` unless its devices are exactly those of `reference` (what
+/// flexvm prepared), none is a block device, and every tap and the vsock socket come from the
+/// load's overrides, so no host resource a restore opens is named by `state`. Runs before
+/// anything is opened for the load.
+fn check_devices(
+    reference: &MicrovmState,
+    state: &MicrovmState,
+    params: &LoadSnapshotParams,
+) -> Result<(), RestoreFromSnapshotError> {
+    let refuse = |why: String| Err(RestoreFromSnapshotError::Devices(why));
+    let (Some(want), Some(have)) = (device_set(reference), device_set(state)) else {
+        return refuse("only the MMIO transport can be checked".into());
+    };
+    let VirtioDevicesState::Mmio(mmio) = &state.device_states.virtio_state else {
+        unreachable!("device_set checked the transport");
+    };
+    if let Some(d) = mmio.block_devices.first() {
+        return refuse(format!("block device {:?} is never restored", d.device_id));
+    }
+    if let Some(d) = have.iter().find(|d| !want.contains(d)) {
+        return refuse(format!("{d} was not prepared"));
+    }
+    if let Some(d) = want.iter().find(|d| !have.contains(d)) {
+        return refuse(format!("{d} is missing"));
+    }
+    if want != have {
+        return refuse("devices differ in number or order".into());
+    }
+    for d in &mmio.net_devices {
+        let named = params.network_overrides.iter().any(|o| {
+            o.iface_id == d.device_state.id && o.host_dev_name == d.device_state.tap_if_name
+        });
+        if !named {
+            return refuse(format!(
+                "net {:?} has no tap given by the load",
+                d.device_state.id
+            ));
+        }
+    }
+    if mmio.vsock_device.is_some() && params.vsock_override.is_none() {
+        return refuse("vsock has no socket given by the load".into());
+    }
+    Ok(())
+}
