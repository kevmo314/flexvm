+    let vcpus = vm
+        .create_vcpus(vcpu_count)
+        .map_err(StartMicrovmError::KvmVm)?;
+
+    vm.restore_memory_regions(guest_memory, &microvm_state.vm_state.memory)
+        .map_err(StartMicrovmError::KvmVm)?;
+    vm.prepare_devices(&microvm_state.device_states)
+        .map_err(StartMicrovmError::KvmVm)?;
+    Ok((vm, vcpus))
