+    /// flexvm: undoes whatever prepared device resources were not taken. A pmem mapping whose
+    /// KVM slot cannot be removed stays mapped (the guest could still reach it) and is an error.
+    pub fn drop_prepared_devices(&self) -> Result<(), VmError> {
+        let prepared = std::mem::take(&mut *self.common.prepared_devices.lock().unwrap());
+        let mut res = Ok(());
+        for (path, _, start, _, mmap, slot) in prepared.pmem {
+            let removed = self.set_user_memory_region(kvm_bindings::kvm_userspace_memory_region {
+                slot,
+                guest_phys_addr: start,
+                memory_size: 0,
+                userspace_addr: mmap.mmap_ptr,
+                flags: 0,
+            });
+            if let Err(e) = removed {
+                std::mem::forget(mmap);
+                res = Err(VmError::Prepare(format!(
+                    "cannot remove the slot of unused pmem {path}: {e}"
+                )));
+            }
+        }
+        res
+    }
