+/// Whether the VM prepared from `p` can take `state`, loaded with `params`.
+fn check_prepared(
+    p: &PreparedRestore,
+    state: &MicrovmState,
+    params: &LoadSnapshotParams,
+) -> Result<(), RestoreFromSnapshotError> {
+    let (a, b) = (&p.state, state);
+    let same_regions = a.vm_state.memory.regions.len() == b.vm_state.memory.regions.len()
+        && a.vm_state
+            .memory
+            .regions
+            .iter()
+            .zip(&b.vm_state.memory.regions)
+            .all(|(x, y)| {
+                x.base_address == y.base_address
+                    && x.size == y.size
+                    && x.region_type == y.region_type
+                    && x.plugged.len() == y.plugged.len()
+            });
+    let mismatch = if a.vcpu_states.len() != b.vcpu_states.len() {
+        "vCPU count"
+    } else if a.vm_info.mem_size_mib != b.vm_info.mem_size_mib
+        || a.vm_info.smt != b.vm_info.smt
+        || a.vm_info.cpu_template != b.vm_info.cpu_template
+        || a.vm_info.huge_pages != b.vm_info.huge_pages
+    {
+        "machine configuration"
+    } else if a.kvm_state.kvm_cap_modifiers != b.kvm_state.kvm_cap_modifiers {
+        "KVM capabilities"
+    } else if !same_regions {
+        "memory layout"
+    } else if params.mem_backend.backend_type != MemBackendType::Uffd
+        || p.backend_path != params.mem_backend.backend_path
+        || p.track_dirty_pages != params.track_dirty_pages
+        || p.huge_pages != params.huge_pages
+    {
+        "memory backend"
+    } else {
+        return Ok(());
+    };
+    Err(RestoreFromSnapshotError::Prepared(format!(
+        "{mismatch} differs"
+    )))
 }
