+/// flexvm: the part of `build_microvm_from_snapshot` that only needs the layout of
+/// `microvm_state`: the KVM VM, its vCPUs and memory slots, then the vsock backend and pmem
+/// mappings (`KvmVm::prepare_devices`).
+pub fn prepare_microvm_from_snapshot(
+    microvm_state: &MicrovmState,
+    guest_memory: Vec<GuestRegionMmap>,
+) -> Result<(KvmVm, Vec<crate::Vcpu>), BuildMicrovmFromSnapshotError> {
+    let kvm = Kvm::new(microvm_state.kvm_state.kvm_cap_modifiers.clone())
+        .map_err(StartMicrovmError::Kvm)?;
+    // Set up KVM VM and register memory regions.
+    // Build custom CPU config if a custom template is provided.
+    let mut vm = KvmVm::new(kvm).map_err(StartMicrovmError::KvmVm)?;
