+    /// flexvm: binds the vsock backend's socket and maps the pmem files of `devices` into KVM,
+    /// for the devices restored by the coming snapshot load to take (MMIO transport only).
+    pub fn prepare_devices(
+        &self,
+        devices: &crate::device_manager::DevicesState,
+    ) -> Result<(), VmError> {
+        use crate::device_manager::VirtioDevicesState;
+        let VirtioDevicesState::Mmio(mmio) = &devices.virtio_state else {
+            return Ok(());
+        };
+        let mut prepared = self.common.prepared_devices.lock().unwrap();
+        if let Some(vsock) = &mmio.vsock_device {
+            let (cid, path) = (
+                vsock.device_state.frontend.cid,
+                &vsock.device_state.backend.uds_path,
+            );
+            let backend = crate::devices::virtio::vsock::VsockUnixBackend::new(cid, path.clone())
+                .map_err(|e| VmError::Prepare(format!("vsock: {e}")))?;
+            prepared.vsock = Some((cid, path.clone(), backend));
+        }
+        for pmem in &mmio.pmem_devices {
+            let (config, cs) = (&pmem.device_state.config, &pmem.device_state.config_space);
+            let mmap = crate::devices::virtio::pmem::device::PmemMmap::new(
+                &config.path_on_host,
+                config.read_only,
+            )
+            .map_err(|e| VmError::Prepare(format!("pmem: {e}")))?;
+            if mmap.mmap_len != cs.size {
+                return Err(VmError::Prepare(format!(
+                    "pmem: {} changed size",
+                    config.path_on_host
+                )));
+            }
+            let slot = self
+                .next_kvm_slot(1)
+                .ok_or(VmError::NotEnoughMemorySlots(self.common.max_memslots))?;
+            self.set_user_memory_region(kvm_bindings::kvm_userspace_memory_region {
+                slot,
+                guest_phys_addr: cs.start,
+                memory_size: cs.size,
+                userspace_addr: mmap.mmap_ptr,
+                flags: if config.read_only {
+                    kvm_bindings::KVM_MEM_READONLY
+                } else {
+                    0
+                },
+            })?;
+            prepared.pmem.push((
+                config.path_on_host.clone(),
+                config.read_only,
+                cs.start,
+                cs.size,
+                mmap,
+                slot,
+            ));
+        }
+        Ok(())
+    }
