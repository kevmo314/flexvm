+    /// flexvm: plugs and unplugs memory slots of hotpluggable regions to match `state`, for a VM
+    /// whose memory regions were restored from another snapshot of the same layout.
+    pub fn replug_memory(&self, state: &GuestMemoryState) -> Result<(), VmError> {
+        for rstate in &state.regions {
+            let Some(region) = self
+                .guest_memory()
+                .iter()
+                .find(|r| r.start_addr().0 == rstate.base_address)
+            else {
+                return Err(VmError::Prepare(format!(
+                    "no region at {:#x}",
+                    rstate.base_address
+                )));
+            };
+            let current: Vec<bool> = region.plugged.lock().unwrap().iter().by_vals().collect();
+            if current.len() != rstate.plugged.len() {
+                return Err(VmError::Prepare(format!(
+                    "region at {:#x} has other slots",
+                    rstate.base_address
+                )));
+            }
+            for (i, (&now, &want)) in current.iter().zip(&rstate.plugged).enumerate() {
+                if now != want {
+                    let slot = region.slot_from + u32::try_from(i).unwrap();
+                    region.update_slot(self, &region.mem_slot(slot), want)?;
+                }
+            }
+        }
+        Ok(())
+    }
