+/// flexvm: validate before prepare or restore can open any pmem file. Local legacy
+/// generations may opt out; received generations must never use their absolute host paths.
+fn check_confined_pmem(
+    state: &MicrovmState,
+    confined: bool,
+) -> Result<(), RestoreFromSnapshotError> {
+    if !confined {
+        return Ok(());
+    }
+    let VirtioDevicesState::Mmio(mmio) = &state.device_states.virtio_state else {
+        return Err(RestoreFromSnapshotError::Devices(
+            "only the MMIO transport can be confined".into(),
+        ));
+    };
+    for pmem in &mmio.pmem_devices {
+        let config = &pmem.device_state.config;
+        let path = std::path::Path::new(&config.path_on_host);
+        if !config.read_only
+            || path.is_absolute()
+            || path.components().any(|c| c == std::path::Component::ParentDir)
+        {
+            return Err(RestoreFromSnapshotError::Devices(format!(
+                "pmem {:?} must be read only with a relative path and no '..' components",
+                config.path_on_host
+            )));
+        }
+    }
+    Ok(())
+}
+
+/// The identity of the devices `KvmVm::prepare_devices` sets up from `state`: the transport,
+/// the vsock (cid, socket path) and each pmem (path, read only, guest range), in order.
+#[allow(clippy::type_complexity)]
+fn prepared_devices(
+    state: &MicrovmState,
+) -> (bool, Option<(u64, String)>, Vec<(String, bool, u64, u64)>) {
+    match &state.device_states.virtio_state {
+        VirtioDevicesState::Mmio(mmio) => (
+            true,
+            mmio.vsock_device.as_ref().map(|v| {
+                (
+                    v.device_state.frontend.cid,
+                    v.device_state.backend.uds_path.clone(),
+                )
+            }),
+            mmio.pmem_devices
+                .iter()
+                .map(|p| {
+                    let (c, cs) = (&p.device_state.config, &p.device_state.config_space);
+                    (c.path_on_host.clone(), c.read_only, cs.start, cs.size)
+                })
+                .collect(),
+        ),
+        VirtioDevicesState::Pci(_) => (false, None, Vec::new()),
+    }
+}
+
+/// flexvm: the devices restoring `state` sets up, in order, each with what identifies it and the
+/// host files it opens (pmem). Tap names and the vsock socket are left out: `check_devices`
+/// requires the load's overrides to name them. None for the PCI transport, which is not checked.
+fn device_set(state: &MicrovmState) -> Option<Vec<String>> {
+    let VirtioDevicesState::Mmio(mmio) = &state.device_states.virtio_state else {
+        return None;
+    };
+    let mut set = Vec::new();
+    for d in &mmio.block_devices {
+        set.push(format!("block {:?} at {:?}", d.device_id, d.device_info));
+    }
+    for d in &mmio.net_devices {
+        set.push(format!(
+            "net {:?} (interface {:?}) at {:?}",
+            d.device_id, d.device_state.id, d.device_info
+        ));
+    }
+    if let Some(d) = &mmio.vsock_device {
+        set.push(format!(
+            "vsock {:?} (cid {}) at {:?}",
+            d.device_id, d.device_state.frontend.cid, d.device_info
+        ));
+    }
+    if let Some(d) = &mmio.balloon_device {
+        set.push(format!("balloon {:?} at {:?}", d.device_id, d.device_info));
+    }
+    if let Some(d) = &mmio.entropy_device {
+        set.push(format!("entropy {:?} at {:?}", d.device_id, d.device_info));
+    }
+    for d in &mmio.pmem_devices {
+        let (c, cs) = (&d.device_state.config, &d.device_state.config_space);
+        set.push(format!(
+            "pmem {:?} ({:?}, read only {}, root {}, guest {:#x}+{:#x}) at {:?}",
+            d.device_id,
+            c.path_on_host,
+            c.read_only,
+            c.root_device,
+            cs.start,
+            cs.size,
+            d.device_info
+        ));
+    }
+    if let Some(d) = &mmio.memory_device {
+        set.push(format!(
+            "virtio-mem {:?} at {:?}",
+            d.device_id, d.device_info
+        ));
+    }
+    if mmio.mmds.is_some() {
+        set.push("mmds".into());
+    }
+    if state.device_states.serial_state.is_some() {
+        set.push("serial".into());
+    }
+    Some(set)
+}
