diff -u a/arch/x86/kvm/mmu/tdp_mmu.c b/arch/x86/kvm/mmu/tdp_mmu.c
--- a/arch/x86/kvm/mmu/tdp_mmu.c
+++ b/arch/x86/kvm/mmu/tdp_mmu.c
@@ -1369,6 +1369,74 @@
 }
 
 /*
+ * Removes write access from the leaf SPTEs of [start, end) in @root, and the
+ * MMU-writable and host-writable bits too (as write_protect_gfn() does), so
+ * that fast_page_fault() can't make them writable again: the next write takes
+ * the slow path and asks the primary MMU.
+ */
+static bool tdp_mmu_wrprot_leafs(struct kvm *kvm, struct kvm_mmu_page *root,
+				 gfn_t start, gfn_t end, bool can_yield, bool flush)
+{
+	struct tdp_iter iter;
+	u64 new_spte;
+
+	end = min(end, tdp_mmu_max_gfn_exclusive());
+
+	lockdep_assert_held_write(&kvm->mmu_lock);
+
+	rcu_read_lock();
+
+	for_each_tdp_pte_min_level(iter, kvm, root, PG_LEVEL_4K, start, end) {
+		if (can_yield &&
+		    tdp_mmu_iter_cond_resched(kvm, &iter, flush, false)) {
+			flush = false;
+			continue;
+		}
+
+		if (!is_shadow_present_pte(iter.old_spte) ||
+		    !is_last_spte(iter.old_spte, iter.level))
+			continue;
+
+		new_spte = iter.old_spte & ~(PT_WRITABLE_MASK |
+					     shadow_mmu_writable_mask |
+					     shadow_host_writable_mask);
+		if (new_spte == iter.old_spte)
+			continue;
+
+		tdp_mmu_iter_set_spte(kvm, &iter, new_spte);
+		flush = true;
+	}
+
+	rcu_read_unlock();
+	return flush;
+}
+
+/*
+ * The primary MMU removed write access from the range: write-protect valid
+ * roots' SPTEs, and zap those of invalid roots as kvm_tdp_mmu_unmap_gfn_range()
+ * does (they are only waiting to be freed).
+ */
+bool kvm_tdp_mmu_wrprot_gfn_range(struct kvm *kvm, struct kvm_gfn_range *range)
+{
+	enum kvm_tdp_mmu_root_types types;
+	struct kvm_mmu_page *root;
+	bool flush = false;
+
+	types = kvm_gfn_range_filter_to_root_types(kvm, range->attr_filter) | KVM_INVALID_ROOTS;
+
+	__for_each_tdp_mmu_root_yield_safe(kvm, root, range->slot->as_id, types) {
+		if (root->role.invalid)
+			flush = tdp_mmu_zap_leafs(kvm, root, range->start, range->end,
+						  range->may_block, flush);
+		else
+			flush = tdp_mmu_wrprot_leafs(kvm, root, range->start, range->end,
+						     range->may_block, flush);
+	}
+
+	return flush;
+}
