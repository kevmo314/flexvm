+static bool kvm_mmu_wrprot_gfn_range(struct kvm *kvm, struct kvm_gfn_range *range)
+{
+	kvm_mmu_invalidate_range_add(kvm, range->start, range->end);
+	return kvm_arch_wrprot_gfn_range(kvm, range);
+}
