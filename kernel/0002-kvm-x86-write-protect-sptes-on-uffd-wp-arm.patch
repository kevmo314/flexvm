 #define MMU_NOTIFIER_RANGE_BLOCKABLE (1 << 0)
+/*
+ * Only write permission is removed: present PTEs in the range keep their PFN,
+ * and nothing gains permission. Anything that frees or moves a page in the
+ * range sends its own invalidation. Secondary MMUs may write-protect their
+ * mappings instead of dropping them.
+ */
+#define MMU_NOTIFIER_RANGE_WRPROTECT (1 << 1)
 
