 static int kvm_mmu_notifier_invalidate_range_start(struct mmu_notifier *mn,
 					const struct mmu_notifier_range *range)
 {
 	struct kvm *kvm = mmu_notifier_to_kvm(mn);
+	/*
+	 * Only write permission goes away: keep the mappings, read-only. Faults
+	 * racing with this still retry until range_end(), and pfn caches, which
+	 * write, are still invalidated. Nothing is freed, so there is no memory
+	 * reclaimed to tell the arch about (frees send their own invalidation).
+	 */
+	bool wrprot = range->flags & MMU_NOTIFIER_RANGE_WRPROTECT;
 	const struct kvm_mmu_notifier_range hva_range = {
 		.start		= range->start,
 		.end		= range->end,
-		.handler	= kvm_mmu_unmap_gfn_range,
+		.handler	= wrprot ? kvm_mmu_wrprot_gfn_range :
+					   kvm_mmu_unmap_gfn_range,
 		.on_lock	= kvm_mmu_invalidate_begin,
 		.flush_on_ret	= true,
 		.may_block	= mmu_notifier_range_blockable(range),
@@ -767,7 +787,7 @@
 	 * that guest memory has been reclaimed.  This needs to be done *after*
 	 * dropping mmu_lock, as x86's reclaim path is slooooow.
 	 */
-	if (kvm_handle_hva_range(kvm, &hva_range).found_memslot)
+	if (kvm_handle_hva_range(kvm, &hva_range).found_memslot && !wrprot)
 		kvm_arch_guest_memory_reclaimed(kvm);
 
 	return 0;
