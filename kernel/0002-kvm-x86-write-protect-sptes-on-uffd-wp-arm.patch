+/*
+ * The primary MMU only removed write access from [start, end): write-protect
+ * the TDP MMU's SPTEs instead of zapping them. The shadow MMU, private roots
+ * and the APIC access page still zap.
+ */
+bool kvm_arch_wrprot_gfn_range(struct kvm *kvm, struct kvm_gfn_range *range)
+{
+	lockdep_assert_once(kvm->mmu_invalidate_in_progress);
+
+	if (!tdp_mmu_enabled || kvm_memslots_have_rmaps(kvm) ||
+	    range->attr_filter != KVM_FILTER_SHARED ||
+	    (kvm_x86_ops.set_apic_access_page_addr &&
+	     range->slot->id == APIC_ACCESS_PAGE_PRIVATE_MEMSLOT))
+		return kvm_unmap_gfn_range(kvm, range);
+
+	return kvm_tdp_mmu_wrprot_gfn_range(kvm, range);
+}
